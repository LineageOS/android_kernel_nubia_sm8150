CONFIG_CFI_CLANG=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_NUBIA_DRIVERS=y
CONFIG_NUBIA_FINGERPRINT=y
CONFIG_NUBIA_SENSORS=y
CONFIG_NUBIA_SENSORS_FP_SW6161=y
CONFIG_NUBIA_SENSORS_TMD2725=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_QCA_CLD_WLAN=y
